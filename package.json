{
  "name": "harta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "test": "vitest run",
    "eval:sales": "PROMPTFOO_DISABLE_TELEMETRY=1 npx --yes promptfoo@0.124.1 eval --no-cache --max-concurrency 1 -c evals/sales/promptfooconfig.json",
    "test:openfind": "node --experimental-strip-types --test vendor/openfind/checks/*.check.ts",
    "build:openfind": "vite build --config vendor/openfind/vite.config.ts",
    "check:openfind": "tsc -p vendor/openfind/tsconfig.json",
    "check": "npm test && npm run test:openfind && npm run check:openfind && npm run build:openfind",
    "backup": "node scripts/harta-backup.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "formidable": "^3.5.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.2",
    "multer": "2.4.0",
    "pdf-parse": "1.1.1",
    "pdfkit": "^0.20.2",
    "playwright-core": "1.59.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "undici": "8.12.2",
    "zod": "4.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
