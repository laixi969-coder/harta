{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "noEmit": true, "allowImportingTsExtensions": true,
    "allowJs": true, "checkJs": false, "types": ["node", "vite/client"]
  },
  "include": ["src", "shared", "server/domain.ts"]
}
